# ==============================================================================
# CineSense Monorepo Environment Configuration
# Copy this file to .env or create .env inside the respective subdirectories
# ==============================================================================

# Node Environment
NODE_ENV=development

# ------------------------------------------------------------------------------
# cinesense-app (Next.js 16 Full-Stack Application — Port 3000)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=cinesense_dev_nextauth_secret_change_in_production_32char

# TMDB API (The Movie Database — Free key at https://www.themoviedb.org/settings/api)
# Optional in dev: The app includes offline local catalog fallback for popular titles.
TMDB_API_KEY=your_tmdb_api_key

# YouTube Data API v3 (Optional for trailer search & official channel ingestion)
# Obtain at https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=your_youtube_api_key

# Supabase (Postgres Database, Auth, Realtime — Optional, falls back to local JSON store)
# Obtain at https://supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Multilingual Sentiment Analysis (Optional HuggingFace inference)
# HUGGINGFACE_API_KEY=your_huggingface_api_key

# Social / Review Aggregation (Optional)
# REDDIT_CLIENT_ID=your_reddit_client_id
# REDDIT_CLIENT_SECRET=your_reddit_client_secret
# REDDIT_USER_AGENT=CineSense/1.0.0
# SERPAPI_API_KEY=your_serpapi_api_key

# ------------------------------------------------------------------------------
# backend (Express API Service — Port 5000)
# ------------------------------------------------------------------------------
PORT=5000
SECRET_KEY=cinesense_backend_jwt_secret_32char_minimum
FRONTEND_URL=http://localhost:5173
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cinesense

# ------------------------------------------------------------------------------
# frontend (Vite React Client — Port 5173)
# ------------------------------------------------------------------------------
VITE_API_URL=http://localhost:5000
