# ==============================================================================
# CineSense Backend Environment Configuration
# ==============================================================================

# Server Port (Default: 5000)
PORT=5000

# JWT signing secret (Required for authentication in production)
# Generate with: openssl rand -base64 32
SECRET_KEY=cinesense_dev_secret_replace_in_production_32bytes_min

# Frontend CORS URL
FRONTEND_URL=http://localhost:5173

# Database Connection String
# Leave unset or empty to use the zero-config built-in SQLite database (cinesense.sqlite)
# For production PostgreSQL: postgresql://username:password@localhost:5432/cinesense
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cinesense

# TMDB API Read Access Token (Optional)
# Used for syncing upcoming releases and trailer discovery.
# Obtain free at: https://www.themoviedb.org/settings/api
# TMDB_READ_TOKEN=eyJhbGciOiJIUzI1NiJ9...
# TMDB_API_KEY=your_tmdb_api_key_v3

# YouTube Data API v3 Key (Optional)
# Used for verified channel verification and trailer search.
# Obtain at: https://console.cloud.google.com/apis/credentials
# YOUTUBE_API_KEY=your_google_youtube_api_key
