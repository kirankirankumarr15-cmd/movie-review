# Application Execution
NEXT_PUBLIC_APP_URL=http://localhost:3000

# NextAuth / Auth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_super_secret_string

# Supabase (Postgres + Auth + Storage)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# TMDB API (Canonical Movie Metadata, Cast/Crew, Videos, Watch Providers)
TMDB_API_KEY=your_tmdb_api_key

# YouTube Data API v3 (Trailers, Teasers & Verified Full-Movie Playback)
YOUTUBE_API_KEY=your_youtube_api_key

# Reddit API (r/kannada, r/bollywood, r/movies, r/sandalwood review threads)
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=CineSense/1.0.0

# News & Critic Reviews (SerpAPI / Google Programmable Search / Bing)
SERPAPI_API_KEY=your_serpapi_api_key
BING_SEARCH_API_KEY=your_bing_search_api_key

# Multilingual Sentiment Models (HuggingFace IndicBERT / XLM-RoBERTa)
HUGGINGFACE_API_KEY=your_huggingface_api_key

# Notifications & Push Provider (Resend Email / Web Push)
RESEND_API_KEY=your_resend_api_key
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key

