# ==============================================================================
# CineSense Vite Frontend Environment Configuration
# ==============================================================================

# Backend API Base URL (Default: http://localhost:5000)
VITE_API_URL=http://localhost:5000

# Optional TMDB API v3 Key or v4 Read Token
# Used for direct client-side trailer searches if backend proxy is bypassed.
# Obtain at: https://www.themoviedb.org/settings/api
# VITE_TMDB_API_KEY=your_tmdb_api_key_here
# VITE_TMDB_TOKEN=your_tmdb_bearer_token_here
